/target
**/*.rs.bk
.DS_Store

# MkDocs build output. The site is published from the docs workflow.
/site

# Every example takes an output directory and defaults to the working one, so
# `cargo run --example locus` with no argument writes its figures here. The
# committed copies live in assets/ and docs/assets/figures/ and nowhere else.
/*.svg

# cargo-mutants writes its report here when the advisory workflow is run
# locally. It is an artifact of a run, not part of the repository.
/mutants.out
/mutants.out.old

# The playground's own build directory, since it is a crate of its own rather
# than a member of a workspace.
/playground/target

# The wasm the documentation site's playground runs. Built by the docs
# workflow from src/ and playground/ rather than committed, because a binary in
# a repository is a binary that drifts from the source beside it. To try the
# page on a laptop:
#
#   cargo build --release --target wasm32-unknown-unknown \
#     --manifest-path playground/Cargo.toml
#   cp playground/target/wasm32-unknown-unknown/release/karyon_playground.wasm \
#     docs/assets/
#
# Without it the page says so and points at the command line guide.
/docs/assets/karyon_playground.wasm

# Python leaves this behind when the publish-time script is imported.
__pycache__/
